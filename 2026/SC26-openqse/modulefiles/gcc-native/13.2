#%Module1.0
##
## Compatibility module for the system GCC on Ubuntu noble.
##

proc ModulesHelp { } {
    puts stderr "Adds the system GCC toolchain from the Ubuntu noble base image to the environment."
}

module-whatis "System GCC toolchain from Ubuntu noble (GCC 13)"

set root /usr
# Debian multiarch library directory for this machine.
set arch [exec uname -m]
set libdir $root/lib/$arch-linux-gnu

if { ! [file isdirectory $root] } {
    module-error "System GCC root '$root' does not exist."
}

prepend-path PATH              $root/bin
prepend-path LD_LIBRARY_PATH   $libdir
prepend-path LIBRARY_PATH      $libdir
prepend-path MANPATH           $root/share/man
prepend-path INFOPATH          $root/share/info
prepend-path PKG_CONFIG_PATH   $libdir/pkgconfig
prepend-path CPATH             $root/include
prepend-path C_INCLUDE_PATH    $root/include
prepend-path CPLUS_INCLUDE_PATH $root/include
prepend-path CMAKE_PREFIX_PATH $root
setenv CC                      $root/bin/gcc
setenv CXX                     $root/bin/g++
setenv FC                      $root/bin/gfortran
setenv GCC_ROOT                $root
