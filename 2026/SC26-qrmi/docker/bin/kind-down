#!/bin/bash
# Delete the kind cluster kind-up made. Clusters live on the host's docker,
# so they outlive this container unless deleted.
#
#   kind-down            cluster "fluence"
#   kind-down -n NAME
set -eu
NAME=fluence
while getopts "n:h" opt; do
    case $opt in
        n) NAME=$OPTARG ;;
        *) sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    esac
done
kind delete cluster --name "$NAME"
